{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ 运行当前 Python 文件",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["${file}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
