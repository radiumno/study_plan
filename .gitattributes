# 统一 LF 行尾（Windows 迁移后强制标准化）
* text=auto

# Python 文件强制 LF
*.py text eol=lf

# Markdown 强制 LF
*.md text eol=lf

# JSON/YAML 强制 LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 外壳脚本强制 LF + 可执行
*.sh text eol=lf

# 二进制文件标记
*.png binary
*.jpg binary
*.ico binary
*.db binary
*.sqlite3 binary
